ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Los tres servicios con los que habla el flujo. Los defaults ya apuntan al
# despliegue, asi que un .env con solo la API key alcanza para correr.
# DEMO_API_URL=https://roxygt.lat/demo-api
# DASHBOARD_API_URL=https://roxygt.lat/api
# ROXY_URL=https://roxygt.lat/gateway

ROXY_ENABLED=false
ROXY_MCP_NAME=invoices-mcp
MAX_ROXY_DENIALS=2
