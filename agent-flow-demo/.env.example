ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

MONGO_URI=mongodb://localhost:27017
BILLING_DB_NAME=demo_billing

ROXY_ENABLED=false
# Local: http://localhost:8080
# Nube (AWS/CloudFront): https://roxygt.lat/gateway
# Apuntar a la nube hace que los logs de esta corrida local aparezcan en el
# dashboard desplegado, porque esa Roxy escribe en el Mongo que el dashboard lee.
ROXY_URL=http://localhost:8080
ROXY_MCP_NAME=invoices-mcp
MAX_ROXY_DENIALS=2
