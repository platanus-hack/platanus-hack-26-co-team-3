ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

MONGO_URI=mongodb://localhost:27017
DEMO_API_URL=http://localhost:8001
BILLING_DB_NAME=demo_billing

ROXY_ENABLED=false
# Por defecto la nube; para probar contra un gateway local: http://localhost:8080
# Apuntar a la nube hace que los logs de esta corrida local aparezcan en el
# dashboard desplegado, porque esa Roxy escribe en el Mongo que el dashboard lee.
ROXY_URL=https://roxygt.lat/gateway
ROXY_MCP_NAME=invoices-mcp
MAX_ROXY_DENIALS=2

# API del dashboard donde se registra el arbol de delegacion (/agents).
# Local: http://localhost:8000  |  Nube: https://roxygt.lat/api
DASHBOARD_API_URL=https://roxygt.lat/api
