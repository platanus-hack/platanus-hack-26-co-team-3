vpc_id    = "vpc-xxxxxxxx"
subnet_id = "subnet-xxxxxxxx"

# acm_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/xxxxxxxx"
# mongo_db            = "roxy"
# key_pair_name       = "my-key-pair"
# ssh_ingress_cidr    = "203.0.113.4/32"

# mongo_uri is NOT set here on purpose — it's a secret. Either:
#  - run ./scripts/deploy.sh, which prompts for it (hidden input) and passes it
#    straight to `terraform apply -var`, never writing it to disk, or
#  - run terraform yourself with `-var="mongo_uri=..."` or a TF_VAR_mongo_uri env var.
