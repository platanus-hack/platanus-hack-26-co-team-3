MONGO_URI=mongodb://user:password@host:27017
VPC_ID=vpc-xxxxxxxx
SUBNET_ID=subnet-xxxxxxxx
# URL of the policy/verification service roxy-gateway calls per request (block 10,
# "verifier"). roxy-gateway refuses to start without this set to something reachable.
EVALUATOR_URL=https://your-evaluator-host/evaluate
# Anthropic API key roxy-gateway uses to call Claude (decides how to invoke the MCP tool).
# roxy-gateway refuses to start without it.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Optional — blank/unset uses the CloudFront default certificate:
# ACM_CERTIFICATE_ARN=arn:aws:acm:us-east-1:123456789012:certificate/xxxxxxxx

# Optional, comma-separated — blank/unset means no custom domain (site_url falls back to
# the CloudFront-assigned domain). A cert covering these domains is required, so set
# ACM_CERTIFICATE_ARN above too if you set this:
# DOMAIN_ALIASES=roxygt.lat,www.roxygt.lat

# Optional — blank/unset uses the default, http://localhost:8000/log (dashboard API on the
# same instance). Where roxy-gateway POSTs security log notifications:
# DASHBOARD_URL=http://localhost:8000/log

# Optional — blank/unset uses roxy-gateway's own defaults (claude-sonnet-5 / api.anthropic.com):
# ANTHROPIC_MODEL=claude-sonnet-5
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Optional, defaults to false. Set to true ONLY when changing instance_type: ECS refuses to
# re-register a container instance under a different instance type than it originally
# registered with, so an in-place resize leaves the ECS agent permanently crash-looping.
# true forces a clean destroy+recreate of the EC2 instance instead (a few minutes of
# downtime on all services; the Elastic IP re-associates automatically).
# REPLACE_INSTANCE=true
