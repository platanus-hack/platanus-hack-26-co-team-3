# Copy to .env.production (gitignored) after creating the Atlas cluster.
# Render dashboard: paste these same keys as environment variables.

MONGO_URI=mongodb+srv://roxy_prod:REPLACE_ATLAS_PASSWORD@REPLACE_CLUSTER.mongodb.net/roxy?retryWrites=true&w=majority
MONGO_DB_NAME=roxy
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_BASE_URL=https://api.anthropic.com
DASHBOARD_URL=
